# Umgebungsvariablen der Website ANB Treuhand.
#
# Lokal: diese Datei nach .env.local kopieren und ausfüllen (.env.local kommt nie ins Repository).
# Vercel: unter Settings → Environment Variables für "Production" eintragen, geheime Werte als
# "Sensitive" markieren und danach das letzte Deployment neu starten (Redeploy).
# Werte mit "$" funktionieren in .env-Dateien nur in einfachen Anführungszeichen.

# --- Adresse ---------------------------------------------------------------------------------
# Öffentliche Adresse mit https, ohne Schrägstrich am Ende. Gilt, sobald die eigene Domain
# verbunden ist; vorher verwendet die Seite automatisch die *.vercel.app-Adresse.
NEXT_PUBLIC_SITE_URL=https://www.anb-treuhand.ch

# --- E-Mail (Resend) -------------------------------------------------------------------------
# API-Key von resend.com (Domain anb-treuhand.ch dort verifiziert).
RESEND_API_KEY=
# Empfänger der Kontakt- und Offertanfragen.
CONTACT_TO_EMAIL=info@anb-treuhand.ch
# Absender, muss zur verifizierten Domain gehören.
CONTACT_FROM_EMAIL="ANB Treuhand <website@anb-treuhand.ch>"
# Bestätigung mit Zusammenfassung an die Person, die anfragt. "false" schaltet sie aus.
CONTACT_CONFIRMATION=true
# Nur lokal oder in Previews: prüft die Formulare, versendet aber nichts. Auf Production
# wirkungslos, damit keine echte Anfrage verloren geht.
CONTACT_DRY_RUN=false

# --- Datenbank (Neon) ------------------------------------------------------------------------
# Connection String der Neon-Datenbank (pooled, Region Frankfurt). Tarife, Kopien der Anfragen
# und Anmeldungen des Admin-Bereichs. Die Tabellen legt die Website beim ersten Zugriff selbst an.
DATABASE_URL=
# Geheimer Zufallswert für das Hashen von IP-Adressen (Missbrauchsschutz). Zum Beispiel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTACT_IP_SALT=
# Schützt den täglichen Löschjob (/api/cron/retention). Vercel sendet ihn automatisch mit.
CRON_SECRET=
# Tage, nach denen gespeicherte Anfragen gelöscht werden (Datenschutzerklärung).
CONTACT_RETENTION_DAYS=365

# --- Admin-Bereich ---------------------------------------------------------------------------
# Beide Werte erzeugt die Seite /admin/einrichtung im Browser (Passwort-Hash und QR-Code).
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# --- Suchmaschinen (optional) ----------------------------------------------------------------
# Bestätigungscode der Google Search Console (Methode "HTML-Tag", nur der content-Wert).
GOOGLE_SITE_VERIFICATION=

# --- Tests (optional) ------------------------------------------------------------------------
# Eigene, leere Postgres-Datenbank für die Datenbank-Tests. Wird nicht aus .env-Dateien gelesen,
# sondern beim Aufruf gesetzt: TEST_DATABASE_URL=postgresql://… npm test
# Ihre Tabellen werden bei jedem Lauf geleert.
